# Copy to .env (or export) before running `--mode gemini`
GEMINI_API_KEY=your_google_ai_studio_key_here

# Open-source VLM (Qwen2.5-VL) — fallback AND the "Gemini + OpenSource" column
# in `python run.py compare --mode real`. Any OpenAI-compatible endpoint; pick ONE:
#
#   # Option A — OpenRouter (one key, serves Qwen2.5-VL / InternVL / Llama-Vision):
#   OSS_VLM_BASE_URL=https://openrouter.ai/api/v1
#   OSS_VLM_API_KEY=your_openrouter_key_here
#
#   # Option B — Hugging Face Inference Providers (OpenAI-compatible router):
#   OSS_VLM_BASE_URL=https://router.huggingface.co/v1
#   OSS_VLM_API_KEY=hf_your_token_here
#   # then set model: Qwen/Qwen2.5-VL-72B-Instruct in config/weights.yaml

# Grok (xAI) — the "Gemini + Grok" column in `compare --mode real`. xAI is
# OpenAI-compatible, so the same adapter is reused:
# GROK_BASE_URL=https://api.x.ai/v1
# GROK_API_KEY=your_xai_key_here
